# =============================================================================
# IDP / LLM Gateway
# =============================================================================
LLM_APP_ID=
LLM_BASE_URL=

# =============================================================================
# IDP Identity Provider (auth for LLM and search gateway)
# =============================================================================
IDP_AUTH_URL=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_USER=
IDP_PASSWORD=

# Search gateway path (relative to LLM_BASE_URL)
SEARCH_API_PATH=

# =============================================================================
# Embedding model
# =============================================================================
EMBEDDING_MODEL=text-embedding-3-small-idp
EMBEDDING_DIMENSION=1536

# =============================================================================
# LLM chat endpoint (relative to LLM_BASE_URL)
# =============================================================================
CHAT_COMPLETION_PATH=/chat/completions

# =============================================================================
# Azure AI Search (direct — document upload)
# =============================================================================
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=value-streams
HISTORICAL_AZURE_SEARCH_INDEX_NAME=idp_idmt_data
HISTORICAL_SEARCH_BACKEND=azure
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_SEMANTIC_CONFIG=default
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# =============================================================================
# IDP AI Search Gateway (search queries)
# =============================================================================
AISEARCH_BASE_URL=
AISEARCH_APP_ID=
AISEARCH_DOCUMENTS_API_PATH=/api/v1/aisearch/documents

# =============================================================================
# Neo4j
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_DATABASE=neo4j
NEO4J_TICKET_LABEL=JIRA
NEO4J_TICKET_KEY_PROPERTY=key
NEO4J_GROUP_LINK_FIELD=inwardIssues
NEO4J_ISSUE_TYPE_PROPERTY=issueType

# =============================================================================
# Jira
# =============================================================================
JIRA_BASE_URL=
JIRA_TOKEN=

# =============================================================================
# Ingestion / batch jobs
# =============================================================================
# Ticket source: jira | neo4j
INGESTION_TICKET_SOURCE=neo4j

# Output directories
TICKET_CHUNKS_DIR=ticket_chunks
TICKET_OUTPUT_DIR=ticket_data

# Concurrency
BATCH_MAX_CONCURRENT=3

# Feature flags
ENABLE_LLM=true
ENABLE_EMBEDDINGS=true
FORCE_REPROCESS=false

# SSO token (optional — overrides IDP auth when set)
SSO_TOKEN=

# =============================================================================
# Idea-card audit job
# =============================================================================
AUDIT_MAX_CONCURRENT=5
AUDIT_LLM_MODEL=gpt-5-mini-idp
